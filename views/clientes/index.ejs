<!DOCTYPE html>
<html>
<head>
    <title>Clientes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('../partials/nav') %>
    <div class="container mt-4">
        <!-- FORMULÁRIO DE CADASTRO -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="mb-3">➕ Novo Cliente</h5>

                <form action="/clientes/salvar" method="POST">

                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input type="text" name="nome" class="form-control form-control-lg" required placeholder="Digite o nome do cliente">
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary">Salvar</button>
                    </div>

                </form>

            </div>
        </div>

        <!-- LISTAGEM -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">📂 Clientes</h4>
        </div>

        <!-- 🖥️ DESKTOP -->
        <div class="d-none d-md-block">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th width="120">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% clientes.forEach(clt => { %>
                        <tr>
                            <td><%= clt.id %></td>
                            <td><%= clt.nome %></td>
                            <td>
                                <a href="/clientes/excluir/<%= clt.id %>" 
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Deseja excluir este cliente?')">
                                    🗑️ Excluir
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- 📱 MOBILE -->
        <div class="d-md-none">
            <% clientes.forEach(clt => { %>
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">

                        <h5 class="card-title"><%= clt.nome %></h5>

                        <p class="card-text text-muted">
                            ID: <%= clt.id %>
                        </p>

                        <div class="d-grid">
                            <a href="/clientes/excluir/<%= clt.id %>" 
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Deseja excluir este cliente?')">
                                ❌ Excluir
                            </a>
                        </div>

                    </div>
                </div>
            <% }) %>
        </div>

        <a href="/" class="btn btn-secondary w-100 mt-3">Voltar</a>

    </div>

    <%- include('../partials/footer') %>

</body>
</html>
